generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model Medicine {
  id               String   @id @default(uuid())
  name             String   @unique
  stock            Int
  reorderThreshold Int      @default(10)
  expiryDate       DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
}

model User {
  id           String   @id
  username     String   @unique
  passwordHash String   @map("password_hash")
  email        String   @unique
  role         String
  fullName     String   @map("full_name")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  doctor       Doctor?
  patient      Patient?

  @@map("users")
}

model Patient {
  id               String         @id
  userId           String?        @unique @map("user_id")
  name             String
  dateOfBirth      DateTime       @map("date_of_birth")
  gender           String
  phone            String?        @map("phone")
  contactInfo      String?        @map("contact_info")
  address          String?
  emergencyContact String?        @map("emergency_contact")
  bloodGroup       String?        @map("blood_group")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at")
  appointments     Appointment[]
  clinicalNotes    ClinicalNote[]
  ehrMetadata      EHRMetadata[]
  invoices         Invoice[]
  labOrders        LabOrder[]
  prescriptions    Prescription[]
  vitals           Vitals[]
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("patients")
}

model Doctor {
  id              String         @id
  userId          String?        @unique @map("user_id")
  name            String
  specialization  String
  licenseNumber   String         @unique @map("license_number")
  consultationFee Float          @default(0.0) @map("consultation_fee")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at")
  appointments    Appointment[]
  clinicalNotes   ClinicalNote[]
  labOrders       LabOrder[]
  prescriptions   Prescription[]
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("doctors")
}

model EHRMetadata {
  id             String   @id @default(uuid())
  recordId       String   @unique
  patientId      String
  doctorId       String
  orgName        String
  metadata       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  fhirResourceId String?
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  role      String
  action    String
  details   String
  createdAt DateTime @default(now())
}

model Appointment {
  id             String   @id @default(uuid())
  patientId      String
  patientName    String?
  doctorId       String
  doctorName     String?
  scheduledTime  DateTime
  status         String
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  fhirResourceId String?
  doctor         Doctor   @relation(fields: [doctorId], references: [id])
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Prescription {
  id                  String       @id @default(uuid())
  patientId           String
  patientName         String
  doctorId            String
  doctorName          String?
  diagnosis           String?
  status              String       @default("pending")
  dispensedBy         String?
  dispensedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @default(now()) @updatedAt
  fhirResourceId      String?
  externalReferenceId String?
  assignedPharmacyId  String?
  medications         Medication[]
  doctor              Doctor       @relation(fields: [doctorId], references: [id])
  patient             Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Medication {
  id             String       @id @default(uuid())
  prescriptionId String
  name           String
  dosage         String?
  frequency      String?
  duration       String?
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model LabOrder {
  id                  String    @id @default(uuid())
  patientId           String
  patientName         String
  doctorId            String
  testName            String
  status              String    @default("pending")
  notes               String?
  resultSummary       String?
  critical            Boolean   @default(false)
  resultFields        String?
  processedBy         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt
  doctorNotifiedAt    DateTime?
  patientNotifiedAt   DateTime?
  fhirResourceId      String?
  externalReferenceId String?
  assignedLabId       String?
  doctor              Doctor    @relation(fields: [doctorId], references: [id])
  patient             Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Invoice {
  id          String     @id @default(uuid())
  patientId   String
  patientName String
  totalAmount Float      @default(0)
  status      String     @default("unpaid")
  createdBy   String
  paidAt      DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  patient     Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items       LineItem[]
}

model LineItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  amount      Float
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model ClinicalNote {
  id             String   @id @default(uuid())
  appointmentId  String   @unique
  patientId      String
  doctorId       String
  soapSubjective String?
  soapObjective  String?
  soapAssessment String?
  soapPlan       String?
  recordedBy     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  doctor         Doctor   @relation(fields: [doctorId], references: [id])
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Vitals {
  id            String   @id @default(uuid())
  patientId     String
  appointmentId String
  temperature   Float?
  bloodPressure String?
  pulse         Int?
  spo2          Int?
  recordedBy    String
  createdAt     DateTime @default(now())
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Notification {
  id            String   @id @default(uuid())
  userId        String
  title         String
  message       String
  type          String
  referenceType String
  referenceId   String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
}
