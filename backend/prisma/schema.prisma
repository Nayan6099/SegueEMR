generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Setting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model Medicine {
  id               String   @id @default(uuid())
  name             String   @unique
  stock            Int
  reorderThreshold Int      @default(10)
  expiryDate       DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
}

model User {
  id           String   @id
  username     String   @unique
  passwordHash String   @map("password_hash")
  email        String   @unique
  role         String
  fullName     String   @map("full_name")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")
  doctor       Doctor?
  patient      Patient?

  @@map("users")
}

model Patient {
  id               String             @id
  userId           String?            @unique @map("user_id")
  name             String
  dateOfBirth      DateTime           @map("date_of_birth")
  gender           String
  phone            String?            @map("phone")
  contactInfo      String?            @map("contact_info")
  address          String?
  emergencyContact String?            @map("emergency_contact")
  bloodGroup       String?            @map("blood_group")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at")
  allow_self_entry Boolean            @default(false)
  appointments     Appointment[]
  clinicalNotes    ClinicalNote[]
  ehrMetadata      EHRMetadata[]
  EligibilityCheck EligibilityCheck[]
  invoices         Invoice[]
  labOrders        LabOrder[]
  prescriptions    Prescription[]
  vitals           Vitals[]
  user             User?              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("patients")
}

model Doctor {
  id              String         @id
  userId          String?        @unique @map("user_id")
  name            String
  specialization  String
  licenseNumber   String         @unique @map("license_number")
  consultationFee Float          @default(0.0) @map("consultation_fee")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at")
  appointments    Appointment[]
  clinicalNotes   ClinicalNote[]
  labOrders       LabOrder[]
  prescriptions   Prescription[]
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("doctors")
}

model EHRMetadata {
  id             String   @id @default(uuid())
  recordId       String   @unique
  patientId      String
  doctorId       String
  orgName        String
  metadata       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  fhirResourceId String?
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  role      String
  action    String
  details   String
  createdAt DateTime @default(now())
}

model Appointment {
  id             String   @id @default(uuid())
  patientId      String
  patientName    String?
  doctorId       String
  doctorName     String?
  scheduledTime  DateTime
  status         String
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  clinicalNote   ClinicalNote?
  fhirResourceId String?
  doctor         Doctor   @relation(fields: [doctorId], references: [id])
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Prescription {
  id                  String       @id @default(uuid())
  patientId           String
  patientName         String
  doctorId            String
  doctorName          String?
  diagnosis           String?
  status              String       @default("pending")
  dispensedBy         String?
  dispensedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @default(now()) @updatedAt
  fhirResourceId      String?
  externalReferenceId String?
  assignedPharmacyId  String?
  medications         Medication[]
  doctor              Doctor       @relation(fields: [doctorId], references: [id])
  patient             Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Medication {
  id             String       @id @default(uuid())
  prescriptionId String
  name           String
  dosage         String?
  frequency      String?
  duration       String?
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

model LabOrder {
  id                      String    @id @default(uuid())
  patientId               String
  patientName             String
  doctorId                String
  testName                String
  status                  String    @default("pending")
  notes                   String?
  resultSummary           String?
  critical                Boolean   @default(false)
  resultFields            String?
  processedBy             String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now()) @updatedAt
  fhirResourceId          String?
  externalReferenceId     String?
  assignedLabId           String?
  doctorNotifiedAt        DateTime?
  patientNotifiedAt       DateTime?
  fhirBinaryId            String?
  fhirDocumentReferenceId String?
  fhirObservationIds      String[]  @default([])
  pdfBlobName             String?
  pdfBlobUrl              String?
  doctor                  Doctor    @relation(fields: [doctorId], references: [id])
  patient                 Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model LabAudit {
  id          String   @id @default(uuid())
  labOrderId  String
  action      String
  performedBy String
  performedAt DateTime @default(now())
  details     String?
}

model Invoice {
  id            String     @id @default(uuid())
  patientId     String
  patientName   String
  totalAmount   Float      @default(0)
  status        String     @default("unpaid")
  createdBy     String
  paidAt        DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt
  appointmentId String?    @unique
  patient       Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  items         LineItem[]
}

model LineItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  amount      Float
  cptCode     String?
  icd10Code   String?
  modifiers   String?
  quantity    Int     @default(1)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model ClinicalNote {
  id             String   @id @default(uuid())
  appointmentId  String   @unique
  patientId      String
  doctorId       String
  soapSubjective String?
  soapObjective  String?
  soapAssessment String?
  soapPlan       String?
  recordedBy     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  doctor         Doctor       @relation(fields: [doctorId], references: [id])
  patient        Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
}

model Vitals {
  id            String   @id @default(uuid())
  patientId     String
  appointmentId String
  temperature   Float?
  bloodPressure String?
  pulse         Int?
  spo2          Int?
  recordedBy    String
  createdAt     DateTime @default(now())
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model Notification {
  id            String   @id @default(uuid())
  userId        String
  title         String
  message       String
  type          String
  referenceType String
  referenceId   String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Allergy {
  id        String  @id
  patientId String  @map("patient_id")
  allergen  String
  severity  String
  reaction  String?

  @@map("allergies")
}

model Problem {
  id          String  @id
  patientId   String  @map("patient_id")
  code        String?
  description String
  onsetDate   String? @map("onset_date")

  @@map("problems")
}

model MedicationRefill {
  id             String  @id
  prescriptionId String  @map("prescription_id")
  notes          String?
  status         String  @default("pending")

  @@map("medication_refills")
}

model PatientForm {
  id          String   @id
  patientId   String   @map("patient_id")
  formType    String   @map("form_type")
  formData    String   @map("form_data")
  status      String
  submittedAt DateTime @default(now()) @map("submitted_at")

  @@map("patient_forms")
}

model Message {
  id         String    @id @default(uuid())
  senderId   String    @map("sender_id")
  receiverId String    @map("receiver_id")
  content    String
  sentAt     DateTime  @default(now()) @map("sent_at")
  isRead     Boolean   @default(false) @map("is_read")
  readAt     DateTime? @map("read_at")

  @@map("messages")
}

model PatientApiKey {
  id         String   @id @default(uuid())
  patientId  String   @map("patient_id")
  apiKeyHash String   @map("api_key_hash")
  name       String
  status     String   @default("active")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("patient_api_keys")
}

model Authorization {
  id            String   @id @default(uuid())
  patientId     String
  authorId      String
  authorName    String
  requestedItem String
  payer         String
  status        String   @default("pending")
  createdAt     DateTime @default(now())
}

model EligibilityCheck {
  id          String   @id @default(uuid())
  patientId   String
  patientName String
  payer       String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  patients    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model OfficeNote {
  id         String   @id @default(uuid())
  patientId  String
  authorId   String
  authorName String
  content    String
  createdAt  DateTime @default(now())
}

model PatientEducation {
  id         String   @id @default(uuid())
  patientId  String
  authorId   String
  authorName String
  title      String
  content    String
  createdAt  DateTime @default(now())
}

model patient_intake_audit_logs {
  id         Int       @id @default(autoincrement())
  intake_id  String?   @db.VarChar(50)
  changed_by String?   @db.VarChar(50)
  old_values Json?
  new_values Json?
  changed_at DateTime? @default(now()) @db.Timestamp(6)
}

model patient_intakes {
  id                      String    @id @db.VarChar(50)
  patient_id              String?   @db.VarChar(50)
  doctor_id               String?   @db.VarChar(50)
  marital_status          String?   @db.VarChar(50)
  contact_phone           String?   @db.VarChar(50)
  contact_email           String?   @db.VarChar(100)
  emergency_contact       String?   @db.VarChar(255)
  employer_details        String?   @db.VarChar(255)
  insurance_provider      String?   @db.VarChar(100)
  insurance_policy_number String?   @db.VarChar(100)
  preferred_language      String?   @db.VarChar(50)
  ethnicity               String?   @db.VarChar(50)
  hipaa_consent           Boolean?  @default(false)
  reason_for_visit        String?
  symptoms                String?
  medical_history         String?
  allergies               String?
  medications             String?
  vitals                  Json?
  status                  String?   @default("checked_in") @db.VarChar(50)
  created_at              DateTime? @default(now()) @db.Timestamp(6)
  updated_at              DateTime? @default(now()) @db.Timestamp(6)
}

model recalls {
  id           String   @id @default(uuid())
  patient_id   String
  patient_name String
  doctor_id    String
  reason       String
  due_date     DateTime
  status       String   @default("pending")
  notes        String?
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now())
}
